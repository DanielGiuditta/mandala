[Unit]
Description=Mandala office web application
After=network-online.target

[Service]
User=mandala-web
Group=mandala-web
WorkingDirectory=/opt/mandala/apps/web
EnvironmentFile=/etc/mandala/lan-web.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/mandala/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/opt/mandala/apps/web/.next/cache
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
