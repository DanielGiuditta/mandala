[Unit]
Description=Mandala approved preview receiver
After=network-online.target

[Service]
User=mandala-preview-publisher
Group=mandala-preview
WorkingDirectory=/opt/mandala/apps/lan-services
EnvironmentFile=/etc/mandala/preview-publisher.env
ExecStart=/usr/bin/node previews.mjs
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/mandala-previews
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
