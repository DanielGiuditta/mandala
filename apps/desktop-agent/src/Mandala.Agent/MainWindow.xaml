<Window x:Class="Mandala.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mandala Agent" Height="470" Width="500" MinHeight="470" MinWidth="500"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,22">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="Mandala Agent" />
      <TextBlock Foreground="#5B6472" Margin="0,6,0,0" Text="Project time tracking for this workstation." TextWrapping="Wrap" />
      <TextBlock x:Name="BuildIdentityText" Foreground="#5B6472" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid x:Name="LoginPanel">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="EmailTextBox" Grid.Row="0" Height="38" Margin="0,0,0,10" Padding="10,7" ToolTip="Work email" />
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Height="38" Margin="0,0,0,14" Padding="10,7" ToolTip="Password" />
        <Button x:Name="SignInButton" Grid.Row="2" Height="38" Click="SignInButton_Click" Content="Sign in" />
        <TextBlock x:Name="LoginMessageText" Grid.Row="3" Foreground="#B42318" Margin="0,12,0,0" TextWrapping="Wrap" />
      </Grid>

      <Grid x:Name="TrackerPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="SignedInAsText" Foreground="#5B6472" Grid.Row="0" Margin="0,0,0,12" />
        <ComboBox x:Name="ProjectComboBox" Grid.Row="1" Height="38" />
        <StackPanel Grid.Row="2" Margin="0,14,0,0" Orientation="Horizontal">
          <Button x:Name="StartWorkButton" Width="158" Height="38" Click="StartWorkButton_Click" Content="Start Work" />
          <Button x:Name="StopButton" Width="118" Height="38" Margin="10,0,0,0" Click="StopButton_Click" Content="Stop" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
          <TextBlock x:Name="ActiveProjectText" FontWeight="SemiBold" />
          <TextBlock x:Name="ElapsedText" Foreground="#5B6472" Margin="0,4,0,0" />
          <TextBlock x:Name="TrackerMessageText" Foreground="#B42318" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Grid>

    <StackPanel Grid.Row="2" Margin="0,20,0,0">
      <TextBlock Foreground="#5B6472" Text="The timer pauses after five minutes without Windows keyboard or mouse activity." TextWrapping="Wrap" />
      <Button x:Name="CopyDiagnosticsButton" Margin="0,10,0,0" Height="32" Click="CopyDiagnosticsButton_Click" Content="Save / copy diagnostics for IT" />
    </StackPanel>
  </Grid>
</Window>
