{
  "name": "mandala",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @mandala/web && node scripts/sync-web-next-output.mjs",
    "dev": "npm run dev --workspace @mandala/web",
    "typecheck": "npm run typecheck --workspace @mandala/web",
    "dev:web": "npm run dev --workspace @mandala/web",
    "build:web": "npm run build --workspace @mandala/web",
    "typecheck:web": "npm run typecheck --workspace @mandala/web"
  }
}
